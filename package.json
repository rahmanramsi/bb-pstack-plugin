{
  "name": "bb-plugin-pstack",
  "version": "0.15.25",
  "type": "module",
  "description": "if you want to go fast, go deep first. pstack helps you write less, but higher quality code. rigorous agent workflows you can parallelize with confidence.",
  "license": "MIT",
  "author": "Lauren Tan",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37"
  },
  "bb": {
    "name": "pstack",
    "description": "Rigorous agent workflows: poteto-mode playbooks, multi-model review panels, and engineering principles as skills.",
    "branding": {
      "icon": "Layers",
      "logo": {
        "light": "./assets/logo.png"
      }
    },
    "server": "./src/server.ts",
    "skills": [
      "skills"
    ],
    "app": "./src/app.tsx",
    "host": "./src/host.ts"
  },
  "keywords": [
    "bb-plugin",
    "pstack",
    "poteto-mode",
    "workflow",
    "principles",
    "subagents",
    "unslop"
  ],
  "scripts": {
    "test": "node --test src/*.test.ts src/issues/*.test.ts src/ui/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "@radix-ui/react-slot": "^1.3.0"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.37",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "class-variance-authority": "^0.7.1",
    "better-sqlite3": "^12.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9"
  }
}
